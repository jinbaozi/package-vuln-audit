{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Summary",
  "type": "object",
  "required": [
    "tools",
    "raw_outputs",
    "summary",
    "normalized_candidate_count"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "abnormal",
              "completed-with-findings",
              "incomplete",
              "not-applicable",
              "not-installed",
              "skipped",
              "completed",
              "failed"
            ]
          },
          "output": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "strict_decision": {
            "type": "string"
          },
          "coverage_impact": {
            "type": ["string", "array", "object"]
          },
          "watchdog_events": {
            "type": "array"
          },
          "network_used": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "raw_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "normalized_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strict_decision": {
      "type": "string"
    },
    "coverage_impact": {
      "type": "array"
    },
    "incomplete_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
