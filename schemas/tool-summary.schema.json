{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Summary",
  "type": "object",
  "required": [
    "tools",
    "raw_outputs",
    "summary",
    "normalized_candidate_count"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "abnormal",
              "blocked-pending-confirmation",
              "blocked-recovery-required",
              "completed-with-findings",
              "incomplete",
              "not-applicable",
              "not-installed",
              "skipped",
              "completed",
              "failed"
            ]
          },
          "output": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "strict_decision": {
            "enum": [
              "block",
              "continue",
              "continue-needs-manual-review",
              "needs-install"
            ]
          },
          "coverage_impact": {
            "type": ["string", "array", "object"]
          },
          "watchdog_events": {
            "type": "array"
          },
          "network_used": {
            "type": "boolean"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "shards_total": {
            "type": "integer",
            "minimum": 0
          },
          "shards_completed": {
            "type": "integer",
            "minimum": 0
          },
          "output_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "raw_output_ref": {
            "type": "string"
          },
          "terminal_summary_truncated": {
            "type": "boolean"
          },
          "coverage_profile": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "not_applicable"
            ]
          },
          "accuracy_risk": {
            "enum": [
              "none",
              "limited_coverage",
              "stale_database",
              "malformed_output",
              "missing_tool",
              "manual_confirmation_required"
            ]
          },
          "admission_policy": {
            "enum": [
              "candidate_evidence_allowed",
              "positive_only",
              "manual_review_only",
              "not_admissible"
            ]
          },
          "negative_conclusion_allowed": {
            "type": "boolean"
          },
          "partial_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "raw_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "normalized_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strict_decision": {
      "enum": [
        "block",
        "continue"
      ]
    },
    "blocked_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_impact": {
      "type": "array"
    },
    "incomplete_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
