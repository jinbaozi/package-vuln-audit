{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Hypothesis",
  "type": "object",
  "required": [
    "id",
    "profile",
    "component",
    "assumption",
    "attacker_controlled_input",
    "possible_gap",
    "possible_sink",
    "validation_method",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "assumption": {
      "type": "string"
    },
    "attacker_controlled_input": {
      "type": "string"
    },
    "possible_gap": {
      "type": "string"
    },
    "possible_sink": {
      "type": "string"
    },
    "minimal_extra_code_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_method": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "candidate_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
