{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Intake",
  "type": "object",
  "required": [
    "authorization",
    "scope_summary",
    "source_path",
    "network_policy"
  ],
  "properties": {
    "authorization": {
      "type": "string",
      "minLength": 3
    },
    "scope_summary": {
      "type": "string",
      "minLength": 3
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "network_policy": {
      "enum": ["offline", "online-approved", "restricted"]
    },
    "build_permission": {
      "type": "string"
    },
    "fuzz_permission": {
      "type": "string"
    },
    "disclosure_policy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
