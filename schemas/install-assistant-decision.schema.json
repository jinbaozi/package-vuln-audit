{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Install Assistant Decision",
  "type": "object",
  "required": ["decision", "resume_audit", "missing_after_assist"],
  "properties": {
    "decision": {"enum": ["resume", "blocked", "degrade-explicitly", "dry-run-only", "approved-confirmation", "rejected-confirmation"]},
    "resume_audit": {"type": "boolean"},
    "missing_after_assist": {"type": "array", "items": {"type": "string"}},
    "confirmation_token": {"type": "string"},
    "confirmation_action": {"type": "string"},
    "confirmation_reason": {"type": "object"},
    "summary_file": {"type": "string"},
    "log_digest_file": {"type": "string"},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
